@startuml aficiones-nm-dc
!include ../estilos/final.iuml

    title "Aficiones-NM (variante dinámica)"


    Enum Género << Enumerado >>{
        Masculino
        Femenino
        Otros
    } 
    Class Usuario << Entidad >>{
        nombre: String
        género: Género
        edad: Integer
        email: String
    } 
    Class Afición {
        afición: String
    } 

    Usuario "0..*" -- "0..*" Afición: esAficiondoA >
@enduml
