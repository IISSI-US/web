@startuml asociaciones-1n-clases
!include ../estilos/final.iuml
title Asociaciones 1:N (Diagrama de Clases)


class Universidad {
  nombre: String
  dirección: String
  fundacion: Date
}

class Centro {
  nombre: String
  codigo: String
  presupuesto: Double
}

class Estudiante {
  matrícula: String
  nombre: String
  edad: Integer
  promedio: Double
}

Universidad *-- Centro : contiene >
Centro "1" -- "0..*" Estudiante : inscribe >
@enduml


@startuml asociaciones-mn-clases
!include ../estilos/final.iuml
title Asociaciones N:M (Diagrama de Clases)


class Autor {
  nombre: String
  fechaNacimiento: Date
  nacionalidad: String
}

class Libro {
  isbn: String
  titulo: String
  fechaPublicacion: Date
  numeroPaginas: Integer
}

class Categoría {
  nombre: String
  descripcion: String
}

Autor "1..*{orden}" -- "1..*" Libro : escribe >
Libro "1..*" -- "1..*" Categoría : pertenece >
@enduml


@startuml clase-asociacion-clases
!include ../estilos/final.iuml
title Clase Asociación (Diagrama de Clases)


class Estudiante {
  nombre: String
  email: String
  fechaNacimiento: Date
}

class Curso {
  nombre: String
  codigo: String
  creditos: Integer
}

class Inscripción {
  fechaInscripción: Date
  calificacionFinal: Double
  estado: String
}

Estudiante "0..*" -- "0..*" Curso
(Estudiante, Curso) .. Inscripción
@enduml


@startuml asociacion-reflexiva-clases
!include ../estilos/final.iuml
title Asociación Reflexiva N:M (Diagrama de Clases)


class Usuario {
  usuarioId: Integer
  nombreUsuario: String
  edad: Integer
  genero: Genero
  ciudadOrigen: String
  fechaRegistro: Date
}

enum Genero {
  FEMENINO
  MASCULINO
  NO_BINARIO
  NO_ESPECIFICADO
}

class Seguimiento {
  fechaInicio: Date
}

Usuario "0..*" -- "0..*" Usuario : sigue >
(Usuario, Usuario) .. Seguimiento

@enduml


