@startuml do-ejemplo-asociacion
title Diagrama de objetos con clases asociación
!include ../../puml/final.iuml
!include Empleados.iuml
!include Proyectos.iuml
!include Esfuerzos.iuml

juan -- p1: <u>trabajaEn</u>
juan -- p2: <u>trabajaEn</u>
ana -- p1: <u>trabajaEn</u>
ana -- p2: <u>trabajaEn</u>
cristina -- p2: <u>trabajaEn</u>

(juan, p1) .. f1
(juan, p2) .. f2
(ana, p1) .. f3
(cristina, p2) .. f4
(ana, p2) .. f5
@enduml

