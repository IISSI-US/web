@startuml herencia-completa-disjunta-persona
!include ../../puml/teoria.iuml

skinparam linetype polyline
skinparam InheritanceGrouping 2

class Persona {
  nombre: String
  fechaNacimiento: Date
}

class Empleado {
  numeroEmpleado: String
  salario: Double
}

class Estudiante {
  numeroMatricula: String
  añoIngreso: Integer
}

Persona  <|--  Empleado
Persona <|--  Estudiante : {completa,disjunta}

note top of Persona
  Cada persona es un empleado o 
  un estudiante, pero no ambos.
end note

@enduml

@startuml herencia-incompleta-disjunta-vehiculo
!include ../../puml/teoria.iuml
skinparam linetype polyline
skinparam InheritanceGrouping 2

class Vehículo {
  marca: String
  modelo: String
  año: Integer
}

class Coche {
  numeroPuertas: Integer
  tipoTransmision: String
}

class Moto {
  cilindrada: Integer
  tipoManillar: String
}

Vehículo <|-- Coche
Vehículo <|-- Moto : {incompleta,disjunta}

note top of Vehículo
  Un vehículo puede ser un coche 
  o una moto, o ninguno de los dos.
end note
@enduml


@startuml herencia-incompleta-solapada-recurso-humano
!include ../../puml/teoria.iuml
skinparam linetype polyline
skinparam InheritanceGrouping 2

class RecursoHumano {
  nombre: String
  email: String
  fechaContratacion: Date
}

class Gerente {
  tamañoEquipo: Integer
  presupuesto: Double
}

class Ingeniero {
  especialidad: String
  añosExperiencia: Integer
}

RecursoHumano <|-- Gerente
RecursoHumano <|-- Ingeniero:  {incompleta,solapada}

note top of RecursoHumano
  Pueden existir RRHH que no sean 
  ni gerentes ni ingenieros, o 
  que sean ambos.
end note

@enduml

@startuml ejemplo-vinos
!include ../../puml/teoria.iuml
skinparam linetype polyline
skinparam InheritanceGrouping 2

class Bodega {
  nombre : String
  denominaciónOrigen : String
}

class Vino {
  nombre : String
  grados : Double
}

class Joven {
  tiempoBarrica : Integer
  tiempoBotella : Integer
}

class Crianza {
  tiempoBarrica : Integer
  tiempoBotella : Integer
}

class Uva {
  nombre : String
}

class Cosecha {
  año : Year
  calidad : String
}

Bodega "1" --> "1..*" Vino : produce

Vino "0..*" -l- "1..*" Uva : elaboradoCon
Vino <|-- Joven : {completa,disjunta}
Vino <|-- Crianza

Crianza "1" *-- "1..*" Cosecha

note left of Bodega
RN-1: Los nombres de las bodegas,
vinos y uvas son únicos
end note

note right of Vino
RN-3: la graduación está entre
los 10 y 15 grados
end note

note bottom of Joven
RN-2: Menos de 6 meses en barrica
end note

note left of Crianza
RN-2: 24 meses de crianza: 6 y 12 meses
en barrica y el resto en botella
end note

note bottom of Cosecha
RN-4: Cada vino de crianza tiene
como máximo una cosecha por año
end note
@enduml

