@startuml ejemplo-mdd
!include ../../puml/teoria.iuml
skinparam linetype polyline

class Laboratorio {
  cif
  nombre
  direccion
}

class Catalogo {
  fecha
}

class Almacen {
  nombre
  direccion
}

class LineaCatalogo {
  precioMenorXcien
  precioMasDeCien
}

class Producto {
  codigo
  nombre
  descripcion
}

Laboratorio *-- "0..*" Catalogo: publica
Laboratorio "?" -- "0..*" Almacen: > almacenaProductosEn
Catalogo *-- "1..*" LineaCatalogo: contiene
LineaCatalogo "*" -- "1" Producto : referencia
@enduml



